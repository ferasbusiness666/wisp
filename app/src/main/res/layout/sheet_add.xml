<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_contact"
        android:textColor="@color/wisp_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/addCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_field"
        android:fontFamily="monospace"
        android:hint="@string/add_hint_code"
        android:importantForAutofill="no"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:maxLength="12"
        android:padding="14dp"
        android:textColor="@color/wisp_text"
        android:textColorHint="@color/wisp_text_dim" />

    <EditText
        android:id="@+id/addName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field"
        android:hint="@string/add_hint_name"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="24"
        android:padding="14dp"
        android:textColor="@color/wisp_text"
        android:textColorHint="@color/wisp_text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/add_mutual_hint"
        android:textColor="@color/wisp_text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/addConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/add" />
</LinearLayout>
